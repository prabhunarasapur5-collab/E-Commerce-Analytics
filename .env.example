# ============================================================
# Environment Variables Example for E-Commerce Analytics
# ============================================================

PORT=3000
JWT_SECRET=your_jwt_secret_key_here
SESSION_SECRET=ecom_analytics_secret_key_2026

# OPTION 1: Cloud Single Connection String (Railway, Render, TiDB, etc.)
# DATABASE_URL=mysql://root:password@host:3306/ecommerce_analytics
# MYSQL_URL=mysql://root:password@host:3306/ecommerce_analytics

# OPTION 2: Discrete MySQL Connection Parameters
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=ecommerce_analytics
DB_SSL=false
